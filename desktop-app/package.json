{
  "name": "artvision-studio",
  "productName": "ArtViSiON STUDiO",
  "version": "9.9.0",
  "description": "ArtViSiON Studio with integrated Pro Converter and 174 searchable portfolio mockups (Windows desktop app)",
  "author": "ArtViSiON",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "prestart": "node scripts/sync-portfolio-mockups.js",
    "predist": "node scripts/sync-portfolio-mockups.js"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.artvision.studio",
    "productName": "ArtViSiON STUDiO",
    "files": [
      "main.js",
      "preload.js",
      "app.html",
      "converter.html",
      "mockups.html",
      "js/mockups-data.js",
      "assets/mockups/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ArtViSiON STUDiO"
    }
  }
}
